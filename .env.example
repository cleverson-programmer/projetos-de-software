# Node no host; PostgreSQL e Mailpit pelo Docker Compose.
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5432/moeda_estudantil
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
APP_TIMEZONE=America/Sao_Paulo
# Opcional: restringe a origem permitida. Em produção, definir a URL HTTPS pública.
APP_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=moeda_estudantil
POSTGRES_PORT=5432
APP_PORT=3000

# Migration 003: quatro contas originais. Migration 004: mais contas fictícias.
# DEFAULT_*_PASSWORD vale para os novos usuários do respectivo perfil nas duas cargas.
# DEFAULT_*_EMAIL abaixo vale apenas para as quatro contas originais; detalhes em docs/DADOS_DEMONSTRACAO.md.
DEFAULT_ALUNO_EMAIL=aluno.demo@example.test
DEFAULT_PROFESSOR_EMAIL=professor.demo@example.test
DEFAULT_EMPRESA_EMAIL=cantina.demo@example.test
DEFAULT_LIVRARIA_EMAIL=livraria.demo@example.test
DEFAULT_ALUNO_PASSWORD=Aluno@123456
DEFAULT_PROFESSOR_PASSWORD=Professor@123456
DEFAULT_EMPRESA_PASSWORD=Empresa@123456

# SMTP no host. Na publicação, configurar o provedor real e um remetente autorizado.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Moeda Estudantil <nao-responda@moeda.local>"

# O Compose usa o serviço mailpit; para SMTP externo, é obrigatório alterar estas duas variáveis.
# Configurar também SMTP_USER/PASS/FROM e TLS; exemplos em docs/EMAIL.md.
COMPOSE_SMTP_HOST=mailpit
COMPOSE_SMTP_PORT=1025

# Referência histórica da suíte anterior; não executada nesta implementação.
TEST_DATABASE_URL=postgresql://postgres:testpassword@127.0.0.1:55432/moeda_estudantil_test
