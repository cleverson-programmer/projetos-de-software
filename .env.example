# Sistema de Moeda Estudantil - variáveis de ambiente
# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
# Variáveis já definidas no ambiente do sistema operacional têm prioridade sobre o ".env".

# Porta HTTP do servidor (padrão: 3000).
PORT=3000

# Caminho do arquivo do banco SQLite (relativo à raiz do projeto ou absoluto).
# Se ficar comentado, usa database/moeda_estudantil.db.
# DB_PATH=database/moeda_estudantil.db

# Segredo usado para assinar os tokens de login (use um texto longo e aleatório).
# Se ficar vazio, o servidor gera um segredo temporário e os logins caem a cada reinício.
AUTH_SECRET=

# --- E-mail (nodemailer) ---
# Servidor SMTP. Se ficar vazio, o sistema roda em modo simulado: os e-mails não são enviados,
# apenas impressos no console em linhas "[EMAIL-SIMULADO] {json}".
SMTP_HOST=
# Porta do servidor SMTP (587 para STARTTLS, 465 para TLS direto).
SMTP_PORT=587
# Conexão TLS direta (true/false). Se omitido, é true apenas quando a porta for 465.
SMTP_SECURE=false
# Usuário e senha do SMTP (deixe SMTP_USER vazio se o servidor não exigir autenticação).
SMTP_USER=
SMTP_PASS=
# Remetente exibido nos e-mails.
MAIL_FROM="Moeda Estudantil <nao-responder@exemplo.com>"
